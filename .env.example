# Application Settings
APP_NAME=Workplace Safety Sentinel
APP_VERSION=1.0.0
ENVIRONMENT=development

# Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database
DATABASE_URL=sqlite:///./workplace_safety.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost/workplace_safety

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Vision Service
VISION_SERVICE_ENABLED=false
VISION_SERVICE_URL=http://localhost:8001
MQTT_BROKER_URL=
MQTT_TOPIC_DETECTIONS=safety/detections

# Camera Settings
MAX_CAMERAS=10
RTSP_TIMEOUT_SECONDS=30

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
EVIDENCE_DIR=./evidence
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv

# Notification Services
NOTIFICATIONS_ENABLED=true

# Email Notifications (optional)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams (optional)
TEAMS_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_URL=

# Microsoft Entra ID (optional)
ENTRA_ID_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Azure Services (optional)
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

AZURE_INSIGHTS_ENABLED=false
AZURE_INSIGHTS_INSTRUMENTATION_KEY=

# Risk Intelligence
RISK_EVALUATION_ENABLED=true
CRITICAL_INCIDENT_THRESHOLD=3
HIGH_RISK_ZONE_THRESHOLD=5

# Incident Management
AUTO_ASSIGN_INCIDENTS=false
INCIDENT_RETENTION_DAYS=365
