{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/incidents", "destination": "/index.html" },
    { "source": "/hazards", "destination": "/index.html" },
    { "source": "/actions", "destination": "/index.html" },
    { "source": "/monitoring", "destination": "/index.html" },
    { "source": "/zones", "destination": "/index.html" },
    { "source": "/risk", "destination": "/index.html" },
    { "source": "/analytics", "destination": "/index.html" },
    { "source": "/emergency", "destination": "/index.html" },
    { "source": "/cameras", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
